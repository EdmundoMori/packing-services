{
  "schema_version": 2,
  "kind": "bed_bpp_rl_corpus_transition_v1",
  "status": "frozen_r02a_integrity_verified",
  "units": {
    "length": "mm",
    "volume": "mm3",
    "weight": "kg",
    "time": "s",
    "reward": "dimensionless_volume_fraction"
  },
  "agent_visible_fields": [
    "observation",
    "observation_next",
    "action",
    "action_mask",
    "action_mask_next",
    "reward",
    "terminated",
    "truncated"
  ],
  "audit_only_fields": [
    "episode_id",
    "step_index",
    "order_id",
    "target_id",
    "environment_version",
    "engine_commit",
    "behavior_policy",
    "behavior_seed",
    "rule_proposals",
    "chosen_geometry",
    "end_reason",
    "hashes",
    "units",
    "notes"
  ],
  "forbidden_in_agent_channels": [
    "future_item_dimensions",
    "remaining_count",
    "q_hat",
    "teacher_labels",
    "suffix_item_ids",
    "behavior_log_probs"
  ],
  "off_policy_importance_supported": false,
  "off_policy_note": "R02 does not store behavior_log_probs; do not claim importance-sampling off-policy evaluation.",
  "persistence": {
    "atomic_write": true,
    "confirmed_manifest_required": true,
    "manifest_kind": "bed_bpp_rl_corpus_manifest_r02a",
    "manifest_entries": ["relpath", "sha256", "size_bytes"],
    "paths_relative_to_corpus_root": true,
    "tmp_or_incomplete_rejected": true,
    "duplicate_episode_path_rejected": true,
    "writer_model": "single_writer_exclusive_lock",
    "durability_note": "fsync+atomic replace of episode then manifest; orphan episode after crash before manifest update is not confirmed; no absolute host-crash durability claim",
    "closure_flag_timing": "set on last transition at episode close before single atomic publish; no rewrite of already published transitions",
    "artifacts_for_offline_audit": ["bin_lwh_mm", "input_items", "placements"]
  },
  "validation_levels": {
    "structural": "episode_validation.validate_episode_document",
    "geometry": "AABB containment/non-overlap from persisted placements",
    "volume_return": "recompose placed volume vs rewards and chosen_geometry",
    "complete": "structural+geometry+volume; else status auditoria_no_realizada"
  },
  "transition_record": {
    "observation": {
      "type": "float_vector",
      "dim": 36,
      "feature_names_ref": "observation_spec.FEATURE_NAMES"
    },
    "observation_next": {
      "type": "float_vector",
      "dim": 36,
      "note": "After natural terminal step: terminal view. After truncation: real next open-state observation for bootstrap."
    },
    "action": {
      "type": "int",
      "domain": [0, 1, 2]
    },
    "action_mask": {
      "type": "bool_vector",
      "dim": 3
    },
    "action_mask_next": {
      "type": "bool_vector",
      "dim": 3,
      "note": "On truncation, usable bootstrap mask of the open next state."
    },
    "reward": {"type": "finite_float"},
    "terminated": {"type": "bool"},
    "truncated": {"type": "bool"},
    "mutual_exclusion": "terminated XOR truncated on closing transition",
    "episode_id": {"type": "string"},
    "step_index": {"type": "int", "min": 0},
    "order_id": {"type": "string"},
    "target_id": {"type": "string"},
    "environment_version": {
      "type": "string",
      "example": "bed_bpp_rl_env_r02_v1+ep_c04"
    },
    "engine_commit": {"type": "git_sha", "example": "a5fb46879c7bfbe16400eec2ab985dd23bf30385"},
    "behavior_policy": {
      "type": "string",
      "examples": ["uniform_rules", "fixed_greedy_best_fit"]
    },
    "behavior_seed": {"type": "int_or_null"},
    "rule_proposals": {
      "type": "array",
      "length": 3,
      "items": {
        "rule": "string",
        "action": "int",
        "candidate_index": "int_or_null",
        "geometry": "tuple_or_null"
      }
    },
    "chosen_geometry": {"type": "tuple_or_null"},
    "end_reason": {
      "type": "string_or_null",
      "examples": [
        null,
        "no_legal_candidate_on_reset",
        "no_legal_candidate_after_placement",
        "all_items_placed",
        "budget_wall_cut",
        "budget_decision_cut"
      ]
    },
    "physical_stability_verified": null
  },
  "loader": {
    "module": "paper/studies/bed_bpp_rl/tools/corpus_loader.py",
    "agent_only": true
  },
  "verifier": {
    "module": "paper/studies/bed_bpp_rl/tools/resource_verifier.py",
    "volume_check": "recompose packed AABB volumes via bedbpp_eval.kpis_zhao; not reward re-sum alone"
  }
}
