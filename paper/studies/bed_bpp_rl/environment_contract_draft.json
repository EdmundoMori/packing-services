{
  "schema_version": 1,
  "kind": "bed_bpp_rl_environment_contract",
  "status": "frozen_r02_synthetic_verified",
  "title": "BED-BPP-RL mono-container rule-selection contract",
  "not_official_bedbpp_robotic_protocol": true,
  "physical_stability_verified": null,
  "environment_version": "bed_bpp_rl_env_r02_v1+ep_c04",
  "engine": {
    "generator": "simplified_extreme_points",
    "module": "src/packing_services/algorithms/_extreme_points.py",
    "required_commit": "a5fb46879c7bfbe16400eec2ab985dd23bf30385",
    "required_correction": "C04_post_a5fb468",
    "not_historical_learning_objectives_ee9e0ec": true,
    "not_ems": true,
    "not_pct": true,
    "not_full_crainic_algorithm_1": true
  },
  "problem": {
    "sequence": "BED-BPP original input order",
    "containers": 1,
    "container_source": "order target dimensions",
    "lookahead_p": 1,
    "select_s": 1,
    "orientations_max": 6,
    "constraints": {
      "non_overlap": true,
      "containment": true,
      "allow_rotation": true,
      "max_weight": false,
      "basic_stability": false,
      "load_bearing": false,
      "fragility": false,
      "unloading_sequence": false
    },
    "terminal": "stop_at_first_item_without_legal_candidate",
    "suffix_items": "marked unpacked after terminal item; not decided"
  },
  "observation": {
    "dim": 36,
    "dtype": "float64_python_list_serialized_as_float",
    "source_module_reference": "paper/studies/rl_rule_selection/tools/observation.py",
    "spec_module": "paper/studies/bed_bpp_rl/tools/observation_spec.py",
    "markov_sufficiency_claimed": false,
    "layers": {
      "simulator_internal": "remaining queue, packed session, mask, full legal candidates, unpacked reasons",
      "agent_observation": "36-D present summary only",
      "audit": "order_id, geometries, end_reason, hashes, capture AABB, physical_stability_verified=null"
    },
    "includes": [
      "current_item_normalized_geometry_and_weight",
      "used_height_n",
      "n_packed_n",
      "loaded_weight_n",
      "three_rule_proposal_features"
    ],
    "excludes": [
      "future_item_dimensions",
      "remaining_item_count",
      "suffix_ids",
      "returns_or_q_hat",
      "teacher_labels",
      "item_identifiers_in_observation"
    ]
  },
  "action_space": {
    "type": "discrete_rule_selection",
    "n": 3,
    "domain": [0, 1, 2],
    "rules": [
      "greedy_best_fit",
      "lowest_top",
      "least_height_increase"
    ],
    "identities_preserved_if_geometry_coincides": true,
    "out_of_domain_rejected": true,
    "second_action_space": false
  },
  "reward": {
    "definition": "incremental_nominal_placed_volume / bin_volume",
    "gamma": 1.0,
    "undiscounted_return_equals_u_geom_on_complete_episodes": true,
    "u_geom_definition": "sum of per-step rewards under this contract; verified by recomposing packed AABB volumes"
  },
  "public_api": {
    "reset": "(observation, info)",
    "step": "(observation, reward, terminated, truncated, info)",
    "close": "releases session",
    "truncate_budget": "optional open-episode cut without fabricating transitions"
  },
  "termination_truncation": {
    "terminated_when": [
      "no_legal_candidate_on_reset (zero transitions, explicit summary)",
      "no_legal_candidate_after_placement (auto-stop; no empty-list step)",
      "all_items_placed"
    ],
    "truncated_when": [
      "budget_decision_cut or budget_wall_cut with episode still open"
    ],
    "natural_termination_priority_if_budget_coincides": true,
    "bootstrap_on_truncation": "preserve real next observation and action_mask before marking truncated",
    "zero_action_budget_cut": "summary only; no fabricated zero-reward transition",
    "step_after_close": "rejected",
    "closure_on_published_transitions": "truncated/terminated set atomically at episode close; no retrospective rewrite of published files"
  },
  "implementation": {
    "module": "paper/studies/bed_bpp_rl/tools/environment.py",
    "class": "BedBppRlEnv",
    "does_not_mutate": "paper/studies/rl_rule_selection/tools/environment.py"
  }
}
