{
  "schema_version": 1,
  "kind": "bed_bpp_rl_environment_contract_draft",
  "status": "draft_r01_not_frozen",
  "title": "BED-BPP-RL initial mono-container rule-selection contract",
  "not_official_bedbpp_robotic_protocol": true,
  "physical_stability_verified": null,
  "engine": {
    "generator": "simplified_extreme_points",
    "module": "src/packing_services/algorithms/_extreme_points.py",
    "required_correction": "C04_post_a5fb468",
    "not_historical_learning_objectives_ee9e0ec": true,
    "not_ems": true,
    "not_pct": true,
    "not_full_crainic_algorithm_1": true
  },
  "problem": {
    "sequence": "BED-BPP original input order",
    "containers": 1,
    "container_source": "order target dimensions",
    "lookahead_p": 1,
    "select_s": 1,
    "orientations_max": 6,
    "constraints": {
      "non_overlap": true,
      "containment": true,
      "allow_rotation": true,
      "max_weight": false,
      "basic_stability": false,
      "load_bearing": false,
      "fragility": false,
      "unloading_sequence": false
    },
    "terminal": "stop_at_first_item_without_legal_candidate",
    "suffix_items": "marked unpacked after terminal item; not decided"
  },
  "observation": {
    "dim": 36,
    "source_module_reference": "paper/studies/rl_rule_selection/tools/observation.py",
    "includes": [
      "current_item_normalized_geometry_and_weight",
      "used_height_n",
      "n_packed_n",
      "loaded_weight_n",
      "three_rule_proposal_features"
    ],
    "excludes": [
      "future_item_dimensions",
      "remaining_item_count",
      "suffix_ids",
      "returns_or_q_hat",
      "teacher_labels"
    ]
  },
  "action_space": {
    "type": "discrete_rule_selection",
    "n": 3,
    "rules": [
      "greedy_best_fit",
      "lowest_top",
      "least_height_increase"
    ],
    "identities_preserved_if_geometry_coincides": true,
    "second_action_space": false,
    "note": "Resource studies rule-selection RL; does not claim to represent all placement policies."
  },
  "reward": {
    "definition": "incremental_nominal_placed_volume / bin_volume",
    "gamma": 1.0,
    "undiscounted_return_equals_u_geom_on_complete_episodes": true,
    "u_geom_definition": "sum of per-step rewards under this contract"
  },
  "termination_truncation": {
    "terminated_when": [
      "no_legal_candidate_for_current_item",
      "all_items_placed"
    ],
    "truncated_when": [
      "wall_or_decision_budget_cut_with_episode_open"
    ],
    "terminal_observation": "item features zeroed; proposals empty placeholders; audit records end_reason",
    "budget_cut_export": "mark truncated=true on last stored transition; do not invent completing return"
  },
  "verified_against_reusable_implementation": {
    "build_compact_problem": true,
    "RuleSelectionEnv._assert_contract": true,
    "RuleSelectionEnv.reward": true,
    "observation.encode_observation_no_suffix": true,
    "rules.propose_rules_three_identities": true,
    "ppo_math.terminated_vs_truncated": true
  },
  "pending_adaptations_before_freeze": [
    "expose truncated in environment step API or corpus writer",
    "bind engine commit/hash explicitly in corpus metadata",
    "version bed_bpp_rl wrappers without mutating rl_rule_selection campaign artefacts"
  ]
}
