{
  "schema_version": 1,
  "status": "listo para implementar el evaluador piloto",
  "question": "¿La política aprendida mejora la utilización geométrica frente a GreedyBestFit cuando ambas reciben las mismas candidatas y restricciones?",
  "not_an_external_method": "Este protocolo compara dos políticas del repositorio sobre el mismo generador. No es una comparación externa.",
  "methods": {
    "A": {
      "name": "actor seleccionado con best_epoch=0",
      "checkpoint": "online_policy_ml/artifacts/models/mlp_v1_p1s1_ppo.pt",
      "sha256": "6139beb5c13c6a3f9c701626a1765cf690234f253c2a9b9e4c03185b0228ec24",
      "deserialized": false,
      "role": "Puntúa candidatas ya legales. best_epoch=0 significa el actor inicial conservado por la selección, no una mejora obtenida mediante PPO."
    },
    "B": {
      "name": "GreedyBestFitPolicy",
      "code": "src/packing_services/online/policies.py",
      "role": "Elige entre las mismas candidatas legales por rank_key. Con p=1 no hay otros ítems en la ventana."
    }
  },
  "common_conditions": [
    {
      "id": "p_s",
      "value": {
        "lookahead_p": 1,
        "select_s": 1
      },
      "applies_to_both_without_production_change": true,
      "code": "InformationBudget.from_parameters y run_online_loop en ambos algoritmos"
    },
    {
      "id": "arrival_order",
      "value": "input_order",
      "applies_to_both_without_production_change": true,
      "code": "bed_bpp._merge_parameters y loop.order_items INPUT_ORDER"
    },
    {
      "id": "container",
      "value": {
        "rule": "cada pedido conserva su target registrado",
        "euro-pallet_mm": [
          1200.0,
          800.0,
          2000.0
        ],
        "rollcontainer_mm": [
          800.0,
          700.0,
          2000.0
        ],
        "same_converted_problem_for_both_methods": true
      },
      "applies_to_both_without_production_change": true,
      "code": "bed_bpp._resolve_target_container, líneas 72-95; TARGET_SIZES_MM líneas 21-24"
    },
    {
      "id": "orientations",
      "value": "hasta seis permutaciones si la receta y el ítem permiten rotación",
      "applies_to_both_without_production_change": true,
      "code": "session.orientations_for y geometry.unique_orientations"
    },
    {
      "id": "constraints",
      "value": {
        "non_overlap": true,
        "containment": true,
        "allow_rotation": true,
        "max_weight": true,
        "max_weight_kg": 1500.0,
        "basic_stability": false,
        "load_bearing": false,
        "fragility": false,
        "unloading_sequence": false,
        "same_for_both_targets": true
      },
      "applies_to_both_without_production_change": true,
      "code": "order_to_problem no pasa constraints; _default_constraints para un tipo distinto de STACKING_AWARE, bed_bpp.py líneas 144-149; defaults false en ConstraintFlags, models.py líneas 94-97; max_weight del contenedor es DEFAULT_PALLET_MAX_WEIGHT_KG para euro-pallet y rollcontainer, bed_bpp.py líneas 26 y 89-94"
    },
    {
      "id": "discard",
      "value": "descartar el ítem sin candidata legal y continuar",
      "applies_to_both_without_production_change": true,
      "code": "run_online_loop"
    },
    {
      "id": "candidates_and_mask",
      "value": "ExtremePointOnlineSession y ValidatorMask",
      "applies_to_both_without_production_change": true,
      "code": "Online3DBPPHeuristic.run y DRLPolicy3DBPP.run"
    },
    {
      "id": "remaining_count",
      "value": "el bucle lo pasa a ambas políticas; GreedyBestFitPolicy no lo usa",
      "applies_to_both_without_production_change": true,
      "code": "loop.py decide(..., remaining_count=len(remaining)); policies.py borra el argumento"
    }
  ],
